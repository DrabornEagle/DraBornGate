{
  "expo": {
    "name": "DraBornGate",
    "slug": "draborngate",
    "version": "0.3.9",
    "orientation": "portrait",
    "scheme": "draborngate",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#02070D",
    "splash": {
      "image": "./assets/branding/draborngate-splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#02070D"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#02070D",
      "translucent": false
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#00000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.draborneagle.draborngate"
    },
    "android": {
      "package": "com.draborneagle.draborngate",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#02070D",
        "foregroundImage": "./assets/branding/draborngate-app-icon-foreground.png"
      },
      "blockedPermissions": [
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "icon": "./assets/branding/draborngate-app-icon-safe.png"
    },
    "plugins": [
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "DraBornGate profil fotoğrafı ve teslimat görseli seçebilmek için fotoğraflarınıza erişir.",
          "cameraPermission": "DraBornGate selfie veya teslimat görseli çekebilmek için kameraya erişir.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DraBornGate site konumunu haritada seçmek ve akıllı geçiş mesafesini kontrol etmek için konumunu yalnızca uygulama açıkken kullanır.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#37D8FF",
          "defaultChannel": "draborngate-core",
          "sounds": [
            "./assets/sounds/gate_bell_v2.wav",
            "./assets/sounds/gate_chime_v2.wav",
            "./assets/sounds/gate_digital_v2.wav",
            "./assets/sounds/gate_alert_v2.wav",
            "./assets/sounds/gate_pulse_v2.wav",
            "./assets/sounds/gate_signal_v2.wav"
          ]
        }
      ]
    ],
    "extra": {
      "appVersion": "0.3.9",
      "demoDataVersion": "0.3.9",
      "androidVersionCode": 1,
      "privacyPolicyUrl": "https://www.draborneagle.com/DraBornGate/privacy/",
      "accountDeletionUrl": "https://www.draborneagle.com/DraBornGate/account-deletion/",
      "termsUrl": "https://www.draborneagle.com/DraBornGate/terms/",
      "supportEmail": "support@draborneagle.com"
    },
    "icon": "./assets/branding/draborngate-app-icon-safe.png"
  }
}
